{
  "name": "Socrates IDE - Student Empathy Telemetry & Instructor Alert Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "socrates-telemetry",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "name": "Socrates IDE Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [180, 300],
      "webhookId": "socrates-telemetry-webhook"
    },
    {
      "parameters": {
        "jsCode": "// 1. Validate incoming telemetry payload\nconst body = $input.item.json.body || $input.item.json;\n\nconst student = body.student_name || 'S EDWIN';\nconst question = body.question_title || '1.2.3 Array Reversal';\nconst misconception = body.misconception_tag || 'Logic / Boundary Error';\nconst score = Number(body.ai_score !== undefined ? body.ai_score : 50);\nconst errorContext = body.error_context || 'Assertion check failed';\n\nconst isStruggling = score < 80;\nconst urgency = score < 50 ? 'Critical' : 'High';\n\nreturn {\n  student_name: student,\n  question_title: question,\n  misconception_tag: misconception,\n  ai_score: score,\n  error_context: errorContext,\n  is_struggling: isStruggling,\n  urgency: urgency,\n  timestamp: new Date().toISOString(),\n  instructor_email: 'instructor@socrates.edu'\n};"
      },
      "name": "Validate & Format Telemetry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_struggling }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is Student Struggling?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [620, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.VITE_SUPABASE_URL || 'https://YOUR_SUPABASE_PROJECT.supabase.co') + '/rest/v1/instructor_alerts' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.VITE_SUPABASE_ANON_KEY || 'YOUR_SUPABASE_ANON_KEY' }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.VITE_SUPABASE_ANON_KEY || 'YOUR_SUPABASE_ANON_KEY') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"student_name\": \"{{ $json.student_name }}\",\n  \"question_title\": \"{{ $json.question_title }}\",\n  \"misconception_tag\": \"{{ $json.misconception_tag }}\",\n  \"ai_score\": {{ $json.ai_score }},\n  \"error_context\": \"{{ $json.error_context }}\",\n  \"urgency\": \"{{ $json.urgency }}\",\n  \"status\": \"Action Required\"\n}"
      },
      "name": "Save to Supabase Alert Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [860, 180]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.instructor_email }}",
        "subject": "=🚨 [Socrates IDE Alert] {{ $json.student_name }} is struggling with {{ $json.misconception_tag }}",
        "emailType": "html",
        "message": "=<h2>🚨 Socrates IDE — Real-Time Pedagogical Alert</h2><p>Student <strong>{{ $json.student_name }}</strong> scored <strong>{{ $json.ai_score }}/100</strong> on <strong>{{ $json.question_title }}</strong>.</p><p><strong>Diagnosed Misconception:</strong> <span style='color: #e11d48; font-weight: bold;'>{{ $json.misconception_tag }}</span></p><p><strong>Error Context:</strong> <code>{{ $json.error_context }}</code></p><hr/><p>👉 <a href='https://socrates-web-beta.vercel.app/'>Open Socrates Educator Portal</a> to review student dialogue replay and provide pedagogical feedback.</p>",
        "options": {}
      },
      "name": "Send Gmail Alert to Instructor",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1100, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"alert_dispatched\",\n  \"student\": \"{{ $('Validate & Format Telemetry').item.json.student_name }}\",\n  \"urgency\": \"{{ $('Validate & Format Telemetry').item.json.urgency }}\",\n  \"actions_taken\": [\"saved_to_supabase_alert_queue\", \"sent_instructor_gmail\"],\n  \"timestamp\": \"{{ $('Validate & Format Telemetry').item.json.timestamp }}\"\n}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "POST, OPTIONS"
              }
            ]
          }
        }
      },
      "name": "Respond to Webhook (Alert)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1320, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"normal_progress_logged\",\n  \"student\": \"{{ $json.student_name }}\",\n  \"ai_score\": {{ $json.ai_score }},\n  \"misconception_tag\": \"{{ $json.misconception_tag }}\",\n  \"timestamp\": \"{{ $json.timestamp }}\"\n}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "name": "Respond to Webhook (Normal)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [860, 420]
    }
  ],
  "connections": {
    "Socrates IDE Webhook": {
      "main": [
        [
          {
            "node": "Validate & Format Telemetry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & Format Telemetry": {
      "main": [
        [
          {
            "node": "Is Student Struggling?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Student Struggling?": {
      "main": [
        [
          {
            "node": "Save to Supabase Alert Queue",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond to Webhook (Normal)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Supabase Alert Queue": {
      "main": [
        [
          {
            "node": "Send Gmail Alert to Instructor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Gmail Alert to Instructor": {
      "main": [
        [
          {
            "node": "Respond to Webhook (Alert)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
