# Socrates IDE - Environment Configuration Example

# Google Gemini API Key (Optional: can also be configured dynamically via IDE Settings Modal)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Telemetry & Submission Backend
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
